# Copy to .env for local development (`cp .env.example .env`). Loaded
# automatically by internal/config (a value already set in the real
# environment always wins - see loadDotEnv in internal/config/config.go).
# Never commit a real .env file.

# Also substituted directly into docker-compose.yml's `api` service, with
# no fallback default there - see that file's top comment.
APP_ENV=development
HTTP_PORT=8080

# Three different Postgres roles are used deliberately - see
# internal/config/config.go's DBConfig doc comments for why:
#   DSN         - the app role (DB_APP_ROLE): what the running server uses
#                 for almost everything, fully subject to Row-Level Security.
#   AdminDSN    - the admin role (DB_ADMIN_ROLE): BYPASSRLS, used only for a
#                 handful of narrow, documented pre-tenant-context lookups.
#   MigratorDSN - a role with DDL rights (the Postgres bootstrap superuser
#                 in local dev), used ONLY by `go run ./cmd/migrate` /
#                 `make migrate`, never by the running server.
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/racetify?sslmode=disable
DATABASE_ADMIN_URL=postgres://platform_admin:platform_admin_dev_password@localhost:5432/racetify?sslmode=disable
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5432/racetify?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# The app/admin roles DSN/AdminDSN above connect as - named generically
# (not after this product) since role names/passwords are a deployment
# detail. `go run ./cmd/migrate` / `make migrate` creates these two roles
# (migrations/0003_row_level_security.up.sql) using the same values, so
# these must stay consistent with the credentials embedded in DATABASE_URL/
# DATABASE_ADMIN_URL above.
DB_APP_ROLE=app_user
DB_APP_ROLE_PASSWORD=app_user_dev_password
DB_ADMIN_ROLE=platform_admin
DB_ADMIN_ROLE_PASSWORD=platform_admin_dev_password

# Only used by docker-compose.yml's own ${...} substitution (not read by
# the Go binaries directly - the DSNs above are each passed as one whole
# string, database name and bootstrap-superuser credentials already
# embedded), to keep these consistent across the `postgres`, `migrate` and
# `api` services without hardcoding them a second time in each service
# block. docker-compose.yml has no fallback default for these three - if
# any is missing here, Compose substitutes an empty string - so keep this
# section filled in.
DB_NAME=racetify
DB_MIGRATOR_USER=postgres
DB_MIGRATOR_PASSWORD=postgres

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# HS256 shared secret. Generate a real one for anything beyond a laptop,
# e.g.: openssl rand -base64 48. Also substituted directly into
# docker-compose.yml's `api` service, with no fallback default there.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=racetify
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_TTL=240h
M2M_TOKEN_TTL=60m
EMAIL_VERIFY_TOKEN_TTL=24h
INVITATION_TOKEN_TTL=168h
PASSWORD_RESET_TOKEN_TTL=1h

# Google Sign-In (Social Login). Leave blank to disable - GET
# /api/v1/auth/google/login returns 501 until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Also substituted directly into docker-compose.yml's `api` service, with
# no fallback default there.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object Storage (internal/platform/objectstorage) - the implementation
# guide's §3 deliverable ("Object Storage dapat menerima unggahan via API
# dan menyajikan presigned URL untuk file terenkripsi"), behind a
# swappable driver - the same "disk"/"driver" pattern Laravel's Storage
# facade and AdonisJS's Drive use (one interface, several backends, picked
# by a config value) - see objectstorage.go's package doc.
#
# The two drivers below do NOT share one contract - each is native to its
# backend rather than both being proxied through this API the same way:
#
# "local" (default): every upload/download is proxied through this API's
# own endpoint, HMAC-presigned, and AES-256-GCM encrypted at rest - zero
# external account needed, the right choice for local dev or a genuinely
# self-hosted deployment. STORAGE_ROOT_DIR/STORAGE_PRESIGN_SECRET/
# STORAGE_ENCRYPTION_KEY/STORAGE_PUBLIC_BASE_URL below are "local"-only.
#
# "r2": real Cloudflare R2 (or any S3-compatible bucket, including real AWS
# S3 - see STORAGE_R2_ENDPOINT below) native presigned URLs - the client
# PUTs/GETs bytes directly to/from R2, bypassing this server entirely. That
# means no app-level AES-256-GCM step for this driver (R2's own at-rest
# encryption is relied on instead), and one extra step after uploading: the
# client must call POST .../storage/objects/complete-upload once the PUT to
# R2 finishes, since this server never observes it and can not otherwise
# tell the upload happened. Needs the STORAGE_R2_* vars further down filled
# in; the STORAGE_PRESIGN_SECRET/STORAGE_ENCRYPTION_KEY/
# STORAGE_PUBLIC_BASE_URL/STORAGE_ROOT_DIR above are then all ignored. Not
# exercised against a live R2 bucket in this sandbox (no credentials, and
# this environment's network egress does not reach Cloudflare - see
# objectstorage.go's package doc) - please verify against a real bucket
# before relying on it in production, the same caveat this repo's README
# already gives docker-compose.yml.
STORAGE_DRIVER=local
STORAGE_ROOT_DIR=./data/storage
# "local"-only. Signs presigned upload/download URLs (HMAC-SHA256). Keep
# this as secret as JWT_SECRET. Generate a real one for anything beyond a
# laptop, e.g.: openssl rand -base64 48
STORAGE_PRESIGN_SECRET=dev-only-insecure-presign-secret-change-me
# "local"-only. 32-byte AES-256 key, hex-encoded (64 hex chars). Generate a
# real one with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# "local"-only. Prefixes the stable, unsigned URLs handed out for the
# public bucket (tenant logos, photo thumbnails) - set to wherever this API
# is actually reachable from a browser/CDN in each environment.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
# Applies to either driver: how long a presigned upload/download URL stays
# valid for.
STORAGE_UPLOAD_TTL=15m
STORAGE_DOWNLOAD_TTL=15m

# STORAGE_DRIVER=r2 only, from an R2 API token
# (https://developers.cloudflare.com/r2/api/s3/tokens/) scoped to one
# bucket. Leave all blank while STORAGE_DRIVER=local.
STORAGE_R2_ACCOUNT_ID=
# Overrides the derived https://<STORAGE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# endpoint - leave blank for ordinary R2 use; set it to point this same
# driver at real AWS S3 or another S3-compatible provider instead.
STORAGE_R2_ENDPOINT=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_ACCESS_KEY_SECRET=
# One bucket holds both the public and private buckets, namespaced
# <bucket-name-you-set-here>/public|private/<tenant_id>/<key> - see
# objectstorage.R2Config's doc comment for why one bucket rather than two.
STORAGE_R2_BUCKET=
# Optional. A custom domain or r2.dev subdomain mapped to STORAGE_R2_BUCKET
# in the Cloudflare dashboard
# (https://developers.cloudflare.com/r2/buckets/public-buckets/), used for
# a genuinely stable, unsigned public-bucket URL. Left blank, the r2 driver
# falls back to a long-lived (7-day) presigned URL instead, so this is not
# required to get a working public-bucket URL - just a longer-lived one.
STORAGE_R2_PUBLIC_BASE_URL=
